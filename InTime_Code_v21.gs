}

function revNovaSifra_(redci, sifraKl, verzijaOdId) {
  var K = REV_K_, max = 0, stara = null;
  for (var i = 0; i < redci.length; i++) {
    if (String(redci[i][K.sifraKlijenta]) !== sifraKl) { continue; }
