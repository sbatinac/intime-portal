  var a = [];
  try { a = JSON.parse(s || '[]'); } catch (e) { a = []; }
  if (!Array.isArray(a)) { return []; }
  return a.filter(function(x) { return x && x.id; }).map(function(x) { return { id: String(x.id), name: String(x.name || ''), size: Number(x.size) || 0, inline: !!x.inline }; });
}
