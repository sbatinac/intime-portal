  var dodHtml = (dod.poslovnica || dod.zaduzeni || p.awb || p.odrediste) ? '<p style="background:#eef2ff;border-left:5px solid #2d3a8c;padding:8px 14px;margin:0 0 12px;font-size:13.5px;">' +
