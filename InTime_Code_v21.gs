  {sec:'Ostalo'},
  ['odbijenica_newsletter', 'Newsletter pristanak (odbijenica)']
];

function buildOdbijenicaExportDoc_(doc, fields) {
  // Napomena KAM-a (20.9.2026., drugi val — vidi buildKlijentExportDoc_ za
