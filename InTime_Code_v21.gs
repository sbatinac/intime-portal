var BATTLE_HEADER_ = ['Ključ događaja', 'Datum događaja', 'OIB', 'Firma', 'Događaj (vrsta)', 'Bodovi', 'Kampanja / izvor', 'Zabilježeno'];
var BATTLE_VRSTE_ = {
