          if (iAr !== -1 && r[iAr] && !imaArhiva[oib]) { imaArhiva[oib] = true; out.push({ oib: oib, vrsta: 'ARHIVA', naziv: naziv, datum: pismaDatum_(r[iAr]), izvor: s0.izvor }); }
