    }
    if (ukupno > ODG_MAX_UKUPNO_BAJTOVA_) { return { status: 'error', message: 'Privitci su ukupno preveliki (' + (ukupno / 1048576).toFixed(1) + ' MB, najviše 24 MB) — pošalji ih u dva maila ili izbaci jedan.' }; }
    var opcije = {};
