    } else if (data.action === 'adminBrziLozinkaSpremi') {
      result = adminBrziLozinkaSpremi(data.token, data.lozinka);
    } else if (data.action === 'otvPonudaUpitnikInfo') {
      // Javna akcija — `data.token` je token potvrde ponude iz poveznice (ne admin token), isto kao potvrdaPonudeInfo.
      result = otvPonudaUpitnikInfo(data.token);
    } else if (data.tip === 'interes' && data.otvorena_token) {
      result = otvPonudaSpremiUpitnik(data);
    } else if (data.tip === 'interes') {
      result = saveUpit(data);
    } else if (data.tip === 'raskid') {
      result = saveRaskid(data);
    } else if (data.tip === 'anketa') {
      result = saveAnketa(data);
    } else if (data.tip === 'odbijenica') {
      result = saveOdbijenica(data);
    } else {
      // NEPOZNAT zahtjev (npr. bot/skener koji pogađa Web App URL bez
      // ispravnog action/tip polja) — NE tretiramo kao odbijenicu (stari
      // "catch-all" ovdje je slao lažne "Odbijenica — nepoznata tvrtka"
      // mailove na svaki takav zahtjev). Samo vraćamo grešku, bez upisa u
      // Sheet i bez slanja maila.
      result = { status: 'error', message: 'Nepoznata akcija.' };
    }
  } catch (err) {
    result = { status: 'error', message: err.message };
  }
  try { if (!(data && data.action && CISTA_CITANJA_RE_.test(String(data.action)))) { pogodciKesObrisi_(); } } catch (ePk_) { /* v371: keš pogodaka */ }
  try { if (data && data.poslaoAI === true && result && result.status === 'ok') { aiSlanjeZabiljezi_(data); } } catch (eAi_) { /* bilješka nije kritična */ }
  if (ZAUSTAVLJENI_PRIVITCI_.length && result && typeof result === 'object' && !Array.isArray(result)) { result.zaustavljeniPrivitci = ZAUSTAVLJENI_PRIVITCI_.slice(0, 20); }
  return ContentService
    .createTextOutput(JSON.stringify(result))
    .setMimeType(ContentService.MimeType.JSON);
}

